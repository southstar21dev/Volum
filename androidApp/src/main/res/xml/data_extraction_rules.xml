<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. allowBackup="false" turns cloud backup off but not device-to-device
    transfer, so the sign-in token is left out of both explicitly: the encrypted store (its Keystore
    key never leaves this device, so a copy is useless) and the plain file earlier builds used.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secure" />
        <exclude domain="file" path="auth.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure" />
        <exclude domain="file" path="auth.json" />
    </device-transfer>
</data-extraction-rules>
